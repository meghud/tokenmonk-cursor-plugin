{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "type": "command",
        "timeout": 5,
        "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/capture-prompt-submit.js\""
      },
      {
        "type": "command",
        "timeout": 5,
        "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/announce.js\""
      }
    ],
    "sessionStart": [
      {
        "type": "command",
        "timeout": 5,
        "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/flush-spool.js\""
      },
      {
        "type": "command",
        "timeout": 10,
        "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/sync-skills.js\" --caller=sessionstart"
      }
    ],
    "stop": [
      {
        "type": "command",
        "timeout": 5,
        "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/flush-spool.js\""
      }
    ],
    "afterAgentResponse": [
      {
        "type": "command",
        "timeout": 5,
        "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/flush-spool.js\""
      }
    ],
    "afterAgentThought": [
      {
        "type": "command",
        "timeout": 5,
        "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/flush-spool.js\""
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "timeout": 5,
        "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/capture-tool-use.js\""
      }
    ],
    "postToolUseFailure": [
      {
        "type": "command",
        "timeout": 5,
        "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/capture-tool-use.js\""
      }
    ],
    "afterMCPExecution": [
      {
        "type": "command",
        "timeout": 5,
        "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/capture-tool-use.js\""
      }
    ]
  }
}
